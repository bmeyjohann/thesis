+# RSL-RL Configuration for OGBench environments
+# Top-level keys expected by OnPolicyRunner
+
+# -- general runner config
+class_name: OnPolicyRunner
+num_steps_per_env: 1024  # number of steps per environment per iteration  
+max_iterations: 1000  # number of policy updates
+seed: 42
+# -- observations
+obs_groups: {"policy": ["policy"], "critic": ["policy"]} # maps observation groups to types
+# -- logging parameters
+save_interval: 25  # check for potential saves every `save_interval` iterations
+experiment_name: ogbench_experiment
+run_name: ""
+# -- logging writer
+logger: wandb  # tensorboard, neptune, wandb
+wandb_project: ogbench-rsl-rl
+# -- environment settings
+max_episode_length: 1000  # longer episodes for better exploration (increased from 500)
+# -- custom metrics
+log_goal_success_rate: true  # track goal achievement percentage like train_unified.py
+log_episode_completion_metrics: true  # detailed episode completion tracking
+
+# -- policy (top-level key expected by OnPolicyRunner)
+policy:
+  class_name: ActorCritic
+  activation: elu
+  actor_obs_normalization: false
+  critic_obs_normalization: false
+  actor_hidden_dims: [256, 256, 256]
+  critic_hidden_dims: [256, 256, 256]
+  init_noise_std: 1.0
+  noise_std_type: "scalar"  # 'scalar' or 'log'
+
+# -- algorithm (top-level key expected by OnPolicyRunner)
+algorithm:
+  class_name: PPO
+  # -- training
+  learning_rate: 3.0e-4
+  num_learning_epochs: 5
+  num_mini_batches: 4  # mini batch size = num_envs * num_steps / num_mini_batches
+  schedule: adaptive  # adaptive, fixed
+  # -- value function
+  value_loss_coef: 1.0
+  clip_param: 0.2
+  use_clipped_value_loss: true
+  # -- surrogate loss
+  desired_kl: 0.01
+  entropy_coef: 0.01
+  gamma: 0.99
+  lam: 0.95
+  max_grad_norm: 1.0
+  # -- miscellaneous
+  normalize_advantage_per_mini_batch: false
\ No newline at end of file
